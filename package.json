{
  "name": "stock-ticker",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "DSH 桌面端右上角的 A 股自选行情悬浮条：红涨绿跌、盘中按秒刷新、深浅色自适应",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.png"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "stock",
    "ticker",
    "a-share",
    "行情"
  ],
  "scripts": {
    "test": "node --test tests/",
    "prepack": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngChow/stock-ticker-plugin.git"
  }
}
